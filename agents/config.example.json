{
  "_readme": "Copy to agents/config.json (gitignored) and edit. Model names must match `ollama list` exactly. See agents/README.md.",

  "githubRepo": "gregersonartglitch/intrepid-archive",
  "baseBranch": "feature/cuneiform-buttons",

  "workWindow": { "start": "09:00", "end": "15:00" },
  "maxIssuesPerRun": 2,
  "maxProposalsPerDay": 5,
  "reviewMaxChars": 60000,

  "checks": [
    "node --check fog.js",
    "node scripts/smoke-journey-flow.js"
  ],
  "protectedPaths": ["agents/", "AGENTS.md", "CLAUDE.md", "netlify.toml", "_redirects", ".netlify/", "netlify/", ".github/"],
  "maxFileMB": 2,

  "notify": { "ntfyTopic": "" },

  "providers": {
    "claude": {
      "_note": "Claude Code on your Claude subscription. Scarce: briefing, hard issues, final review.",
      "type": "cli",
      "command": "claude",
      "args": ["-p", "--output-format", "text", "--permission-mode", "acceptEdits",
               "--allowedTools", "Read", "Edit", "Write", "Glob", "Grep", "Bash(node:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)"],
      "timeoutMinutes": 40,
      "cooldownHours": 5
    },

    "kimi": {
      "_note": "Kimi on Ollama Cloud, driven by Claude Code. Off until you run `ollama signin` and confirm the tag with `ollama list`.",
      "enabled": false,
      "type": "cli",
      "requiresOllama": true,
      "command": "claude",
      "args": ["-p", "--model", "kimi-k2.6:cloud", "--output-format", "text", "--permission-mode", "acceptEdits",
               "--allowedTools", "Read", "Edit", "Write", "Glob", "Grep", "Bash(node:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)"],
      "env": { "ANTHROPIC_BASE_URL": "http://localhost:11434", "ANTHROPIC_AUTH_TOKEN": "ollama", "ANTHROPIC_API_KEY": "" },
      "timeoutMinutes": 40,
      "cooldownHours": 5
    },

    "qwen-coder": {
      "_note": "Local Qwen driven by Claude Code, for size:small issues. Needs OLLAMA_CONTEXT_LENGTH >= 32768 on the Ollama server.",
      "type": "cli",
      "requiresOllama": true,
      "command": "claude",
      "args": ["-p", "--model", "qwen3.8:27b", "--output-format", "text", "--permission-mode", "acceptEdits",
               "--allowedTools", "Read", "Edit", "Write", "Glob", "Grep", "Bash(node:*)", "Bash(git status:*)", "Bash(git diff:*)"],
      "env": { "ANTHROPIC_BASE_URL": "http://localhost:11434", "ANTHROPIC_AUTH_TOKEN": "ollama", "ANTHROPIC_API_KEY": "" },
      "timeoutMinutes": 30,
      "cooldownHours": 0
    },

    "qwen": {
      "_note": "Local Qwen as a plain chat model: reviews, briefing fallback.",
      "type": "ollama",
      "url": "http://localhost:11434",
      "model": "qwen3.8:27b",
      "numCtx": 32768,
      "timeoutMinutes": 20,
      "cooldownHours": 0
    },

    "gemma": {
      "_note": "Local Gemma: fast summaries and wrap-up.",
      "type": "ollama",
      "url": "http://localhost:11434",
      "model": "gemma4:12b",
      "numCtx": 32768,
      "timeoutMinutes": 15,
      "cooldownHours": 0
    }
  },

  "roles": {
    "briefing":  ["claude", "qwen", "gemma"],
    "code":      ["kimi", "claude", "qwen-coder"],
    "codeSmall": ["qwen-coder", "kimi", "claude"],
    "review":    ["claude", "kimi", "qwen"],
    "wrapup":    ["gemma", "qwen", "claude"]
  }
}
